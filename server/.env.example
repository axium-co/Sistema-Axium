# Banco de dados PostgreSQL (Neon, Supabase, Railway, Render, etc.)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo para assinar os tokens JWT (troque por um valor seguro)
JWT_SECRET="coloque-um-segredo-aqui-mude-isso"

# Tempo de expiração do token JWT (ex: 7d, 24h)
JWT_EXPIRES_IN=7d

# Porta onde o servidor vai rodar (normalmente definida pela plataforma de hospedagem)
PORT=3001

# Origens permitidas no CORS (separadas por vírgula)
# Ex: http://localhost:5173,https://meu-frontend.vercel.app
CORS_ORIGIN="http://localhost:5173"

# Ambiente (development, production)
NODE_ENV=development
